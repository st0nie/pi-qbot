{
  "name": "pi-qbot",
  "version": "0.1.0",
  "description": "Official QQ Bot bridge for pi: one directory + pi session per QQ group, human-like chat",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "qqbot"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/qq-quote-reply",
      "./skills/qq-mention"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st0nie/pi-qbot.git"
  }
}
